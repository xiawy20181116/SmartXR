# Python cache
__pycache__/
*.py[cod]

# Local detection venv (optional numpy/opencv/ncnn for module-1 PC-offload tools)
.venv-detect/
.venv/

# Local harness/test scratch space
.tmp/

# Android and Godot build outputs
*.apk
*.idsig
*.keystore
godot-android/builds/
godot-android/addons.disabled/
android-client/build/
godot-android/android/build/.gradle/
godot-android/android/build/build/
godot-android/android/build/src/main/assets/

# Godot Android export template AAR (regenerated by the Godot exporter on build;
# previously committed copy was >300 MB and rejected by GitHub's 100 MB limit —
# see YAN-56 / option A history rewrite for context). The arm64-v8a/ .so jniLibs
# under the same parent ARE intentionally tracked and are not matched here.
godot-android/android/build/libs/*/godot-lib.*.aar
godot-android/android/build/libs/**/*.aar

# Godot editor/import cache. Keep extension_list.cfg because export tests rely on it.
godot-android/.godot/editor/
godot-android/.godot/exported/
godot-android/.godot/imported/
godot-android/.godot/*.bin
godot-android/.godot/global_script_class_cache.cfg
