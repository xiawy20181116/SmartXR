[configuration]
entry_symbol = "gxr_sdk_library_init"
compatibility_minimum = "4.6"

[libraries]
android.debug.arm64 = "res://addons/gxr_sdk/bin/android/libgxr_sdk.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/gxr_sdk/bin/android/libgxr_sdk.android.template_release.arm64.so"

; Dependencies (libgxrapi.so, libtracking_hand.so) are loaded via Gradle jniLibs,
; not through GDExtension dependencies, to avoid Godot exporter writing empty files.
