    "camera_axes": "+X right, +Y down, +Z forward",
    "head_axes": "+X right, +Y up, -Z forward",
    "default_conversion": "[x, -y, -z]",
    "right_eye_to_head": "row-major 4x4; <16 elements falls back to the default flip (GDScript only)"
  },
  "tolerances": {
    "python_abs": 1e-09,
    "gdscript_abs": 0.0001
  },
