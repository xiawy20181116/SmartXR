; Android XR moving card client.
config_version=5

[application]

config/name="demo_run"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gyroscope=true

[audio]

driver/enable_input=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 0)

[xr]

openxr/enabled=true
openxr/extensions/hand_tracking=false
shaders/enabled=true
